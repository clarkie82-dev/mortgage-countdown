{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/mortgage.schema.json",
  "type": "object",
  "required": ["currency", "forecastMonthlyReduction", "forecastMode", "entries"],
  "additionalProperties": false,
  "properties": {
    "currency": { "type": "string", "minLength": 1 },
    "forecastMonthlyReduction": { "type": "number", "exclusiveMinimum": 0 },
    "forecastMode": { "type": "string", "enum": ["manual", "auto"] },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "balance"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "balance": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
